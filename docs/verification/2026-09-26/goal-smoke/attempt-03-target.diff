diff --git a/test/labels.test.mjs b/test/labels.test.mjs
index 7300066..a018225 100644
--- a/test/labels.test.mjs
+++ b/test/labels.test.mjs
@@ -5,3 +5,159 @@ import { normalizeLabels } from '../src/labels.mjs'
 test('normalizes an empty array', () => {
   assert.deepEqual(normalizeLabels([]), [])
 })
+
+test('keeps the named export and returns a fresh array', () => {
+  const input = ['a', 'b']
+  const out = normalizeLabels(input)
+
+  assert.equal(typeof normalizeLabels, 'function')
+  assert.ok(Array.isArray(out))
+  assert.deepEqual(out, ['a', 'b'])
+  assert.notEqual(out, input)
+
+  out.push('c')
+  assert.deepEqual(input, ['a', 'b'])
+})
+
+test('trims and lowercases each string', () => {
+  assert.deepEqual(normalizeLabels([' A ', 'b']), ['a', 'b'])
+  assert.deepEqual(normalizeLabels(['Ünïcode', 'STRASSE']), ['ünïcode', 'strasse'])
+})
+
+test('discards empty and whitespace-only results', () => {
+  assert.deepEqual(normalizeLabels(['  ', '\t', '\n', 'x ']), ['x'])
+  assert.deepEqual(normalizeLabels(['', '', '']), [])
+})
+
+test('removes duplicates after normalization preserving first-occurrence order', () => {
+  assert.deepEqual(normalizeLabels([' A ', 'a', 'A']), ['a'])
+  assert.deepEqual(normalizeLabels(['B', ' a ', 'b ', 'C']), ['b', 'a', 'c'])
+})
+
+test('ignores non-index own properties', () => {
+  const input = ['x']
+  input.extra = 'y'
+
+  assert.deepEqual(normalizeLabels(input), ['x'])
+})
+
+test('does not mutate the input array', () => {
+  const input = [' A ', 'b', 'A']
+  const before = structuredClone(input)
+  const firstRef = input[0]
+
+  normalizeLabels(input)
+
+  assert.deepEqual(input, before)
+  assert.equal(input.length, 3)
+  assert.equal(input[0], firstRef)
+})
+
+test('supports frozen dense arrays without mutation', () => {
+  const input = Object.freeze([' A ', 'b'])
+
+  const out = normalizeLabels(input)
+
+  assert.deepEqual(out, ['a', 'b'])
+  assert.ok(Array.isArray(out))
+  assert.notEqual(out, input)
+  assert.ok(Object.isFrozen(input))
+  assert.deepEqual([...input], [' A ', 'b'])
+})
+
+test('throws TypeError for non-array inputs', () => {
+  const nonArrays = [
+    'ab',
+    42,
+    NaN,
+    null,
+    undefined,
+    {},
+    new Set(['a']),
+    (function () {
+      return arguments
+    })('a'),
+  ]
+
+  for (const value of nonArrays) {
+    assert.throws(() => normalizeLabels(value), TypeError)
+  }
+})
+
+test('throws TypeError for arrays containing non-string elements', () => {
+  const invalid = [
+    [1],
+    [null],
+    [undefined],
+    [true],
+    [{}],
+    [[]],
+    [Symbol('s')],
+    [() => {}],
+    [NaN],
+    ['a', 2],
+  ]
+
+  for (const value of invalid) {
+    assert.throws(() => normalizeLabels(value), TypeError)
+  }
+})
+
+test('throws TypeError for sparse arrays with ordinary holes', () => {
+  const fromLiteral = ['a', , 'c'] // eslint-disable-line no-sparse-arrays
+  const fromConstructor = new Array(2)
+  const fromTrailingHole = ['a', 'b']
+  fromTrailingHole.length = 3
+
+  assert.throws(() => normalizeLabels(fromLiteral), TypeError)
+  assert.throws(() => normalizeLabels(fromConstructor), TypeError)
+  assert.throws(() => normalizeLabels(fromTrailingHole), TypeError)
+
+  // The hole semantic being tested: for...of / spread yield undefined for the
+  // absent index, while map/forEach/filter skip it without invoking callbacks.
+  assert.deepEqual([...fromLiteral], ['a', undefined, 'c'])
+  let visited = 0
+  fromLiteral.forEach(() => {
+    visited += 1
+  })
+  assert.equal(visited, 2)
+})
+
+test('throws TypeError when a hole is created by delete', () => {
+  const input = ['a', 'b']
+  delete input[1]
+
+  assert.equal(Object.prototype.hasOwnProperty.call(input, 1), false)
+  assert.throws(() => normalizeLabels(input), TypeError)
+})
+
+test('throws TypeError for a hole whose prototype provides a string', () => {
+  const proto = []
+  proto[0] = 'from-proto'
+  const child = []
+  Object.setPrototypeOf(child, proto)
+  child.length = 1
+
+  // The value is readable through the prototype chain, but it is not owned.
+  assert.equal(child[0], 'from-proto')
+  assert.equal(Object.prototype.hasOwnProperty.call(child, 0), false)
+  assert.throws(() => normalizeLabels(child), TypeError)
+})
+
+test('throws TypeError for frozen sparse arrays', () => {
+  const input = Object.freeze(['a', , 'c']) // eslint-disable-line no-sparse-arrays
+
+  assert.throws(() => normalizeLabels(input), TypeError)
+})
+
+test('throws TypeError even when a valid prefix precedes a bad index', () => {
+  assert.throws(() => normalizeLabels(['ok', 2]), TypeError)
+  assert.throws(() => normalizeLabels(['ok', , 'c']), TypeError) // eslint-disable-line no-sparse-arrays
+})
+
+test('validates before producing any output for invalid later indices', () => {
+  const input = ['a', 'b', 'a']
+  delete input[2]
+
+  assert.throws(() => normalizeLabels(input), TypeError)
+})
