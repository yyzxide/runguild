+
+  assert.deepEqual(first, [])
+  assert.notStrictEqual(first, second)
+})
+
+test('throws TypeError for non-array input', () => {
+  const invalidInputs = [
+    null,
+    undefined,
+    'admin',
+    42,
+    NaN,
+    true,
+    {},
+    { length: 0 },
+    new Map(),
+    new Set(),
+    new Uint8Array(),
