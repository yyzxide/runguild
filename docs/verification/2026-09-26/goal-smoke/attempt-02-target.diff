+  const withTrailingHoles = ['a']
+  withTrailingHoles.length = 3
+
+  const sparseArrays = [new Array(3), new Array(1), [1, , 3], ['a', , 'b'], withTrailingHoles]
+
+  for (const value of sparseArrays) {
+    assert.throws(() => normalizeLabels(value), TypeError)
+  }
+})
+
+test('trims and lowercases each string', () => {
+  assert.deepEqual(normalizeLabels(['  Hello  ', 'MIXED Case', '\tTag\n']), [
