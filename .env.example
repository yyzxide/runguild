POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://mission:mission@localhost:5432/mission_control
REDIS_URL=redis://localhost:6379
PORT=4000
AUTO_MIGRATE=true
ENABLE_DEV_BOOTSTRAP=true
ENABLE_LOCAL_RUNTIME_CONTROL=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# AUTH_COOKIE_SECURE defaults to false in local development and true in production.
# Set AUTH_COOKIE_SECURE=true explicitly behind production HTTPS.
AUTH_SESSION_LIFETIME_SECONDS=43200
AUTH_SESSION_IDLE_SECONDS=3600
# Generate with: openssl rand -base64 48
INTERNAL_AGENT_TOKEN=
SCHEDULER_INTERVAL_MS=1000
WORKER_HEARTBEAT_MS=5000
MODEL_PROVIDER=openai
MODEL_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=16384
AGENT_CONTEXT_INPUT_TOKENS=65536
AGENT_ID=
REPOSITORY_ROOT=
WORKTREE_ROOT=
AGENT_POLL_MS=1000
AGENT_LEASE_SECONDS=60
AGENT_MAX_TEST_TIMEOUT_MS=120000
AGENT_TEST_COMMANDS_JSON=[["npm","test"],["npm","run","typecheck"]]
INTEGRATION_POLL_MS=2000
INTEGRATION_LEASE_SECONDS=120
INTEGRATION_BATCH_SIZE=10
EVALUATION_POLL_MS=2000
EVALUATION_MATERIALIZATION_BATCH_SIZE=10
EVALUATION_COLLECTION_BATCH_SIZE=100
EVALUATION_LEASE_SECONDS=120
